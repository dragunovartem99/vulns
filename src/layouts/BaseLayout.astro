---
import { Font } from "astro:assets";

import "@/styles/global.css";

import { withBase } from "@/links";

type Props = {
	title: string;
	description: string;
	noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
		<meta name="theme-color" content="#050505" />
		<meta name="referrer" content="no-referrer" />
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />

		<Font cssVariable="--font-mono" preload />
	</head>

	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>

		<slot name="header" />

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<slot name="footer" />

		{/* The glass: bezel, grain, scanlines and glitches laid over everything. */}
		<canvas id="glitch" aria-hidden="true"></canvas>

		<script>
			import { mountGlitch } from "@/modules/glitch";

			const canvas = document.querySelector("#glitch");
			if (canvas instanceof HTMLCanvasElement) void mountGlitch({ canvas });
		</script>
		<style>
			main:focus {
				outline: none;
			}

			main {
				flex: 1;
			}

			#glitch {
				position: fixed;
				inset: 0;
				z-index: 100;
				width: 100%;
				height: 100%;
				pointer-events: none;
				/* Drawn at half resolution; nearest-neighbour keeps the grain hard. */
				image-rendering: pixelated;
				contain: strict;
				opacity: 0;
			}

			#glitch:global(.is-painted) {
				opacity: 1;
				transition: opacity var(--duration-entrance) var(--ease);
			}
		</style>
	</body>
</html>
