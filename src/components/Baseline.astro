---
// The closing card: the defaults that shut half the doors above before anyone
// writes a line of fix. Every one of them is named in a card's fix.
const lines = [
	"# response headers",
	"Content-Security-Policy: script-src 'nonce-{random}' 'strict-dynamic'; object-src 'none';",
	"  base-uri 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'",
	"Strict-Transport-Security: max-age=63072000; includeSubDomains; preload",
	"Set-Cookie: session=…; HttpOnly; Secure; SameSite=Lax",
	"",
	"# install",
	"npm ci --ignore-scripts",
];
---

<section
	id="baseline"
	class="baseline"
	aria-labelledby="baseline-heading"
>
	<h2
		id="baseline-heading"
		class="title"
	>
		<span class="slash">//</span> ship these
	</h2>
	<p class="lede">I check for these first. When they are all there, I move on to someone else.</p>
	<pre><code>{lines.join("\n")}</code></pre>
</section>

<style>
	.baseline {
		display: grid;
		gap: var(--space-m);
		padding-block: var(--space-xl);
		border-top: 1px solid var(--color-line);
		scroll-margin-top: var(--space-m);
	}

	.title {
		font-size: var(--step-1);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.slash {
		color: var(--color-red);
	}

	.lede {
		max-width: var(--measure);
		color: var(--color-text-muted);
	}

	pre {
		margin: 0;
		padding: var(--space-m);
		border: 1px solid var(--color-line);
		background: var(--color-surface);
		font-size: var(--step--1);
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>
